class Solution {
    public:
    int solve(int ind, int sum,vector<int>& coins,vector<vector<int>> &dp){
        if(sum == 0) return 0;
        if(ind == 0){
            
            if(sum % coins[0] == 0) return sum/coins[0];
            return  1e9;   
        }

if(dp[ind][sum] != -1) return dp[ind][sum];
        int pick = 1e9;
        if(coins[ind] <= sum){
            pick = 1+ solve(ind, sum-coins[ind], coins,dp);
        }
        int not_pick = solve(ind-1, sum, coins,dp);

        return dp[ind][sum] = min(pick,not_pick);
    }
public:
    int coinChange(vector<int>& coins, int amount) {
        int n = coins.size();
        vector<vector<int>> dp(n,vector<int> (amount+1,1e9));

        //
        for(int i =0; i<n; i++){
            dp[i][0] = 0;
        }
        for(int i =0; i<= amount; i++){
            if(i % coins[0] == 0) dp[0][i] = i/coins[0];
        }

        for(int ind = 1; ind <n; ind++){
            for(int sum = 1; sum <=amount; sum ++){
                int pick = 1e9;
               if(coins[ind] <= sum){
            pick = 1+ dp[ind][sum-coins[ind]];
              }
               int not_pick = dp[ind-1][sum];

              dp[ind][sum] = min(pick,not_pick);
            }
        }

// 

        int ans = dp[n-1][amount] ;
        if(ans == 1e9) return -1;
        return ans;
    }
};
