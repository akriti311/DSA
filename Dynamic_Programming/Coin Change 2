class Solution {
    public:
    int solve(int ind, int sum,vector<int>& coins,vector<vector<int>> &dp){

       if(ind == 0) {if(sum % coins[0] == 0 || sum == 0) return 1;
        if(coins[0] == 0) return 2;
        
        else return 0;}

        //
        if(dp[ind][sum] != -1) return dp[ind][sum];
     int pick = 0;
        if(coins[ind] <= sum){
            pick = solve(ind, sum-coins[ind], coins,dp);
        }
        int not_pick = solve(ind-1, sum, coins,dp);

        return dp[ind][sum] = pick + not_pick;

    }
public:
    int change(int amount, vector<int>& coins) {
        int n = coins.size();
        vector<vector<int>> dp(n,vector<int> (amount+1,-1));
        return solve(n-1, amount, coins,dp);
    }
};
