class Solution {
    public:
    void binary(vector<int> &nums,int target){
        int n = nums.size();
        int low = 0;
        int high = n-1;
        int ans  = -1;
        while(low <= high){
            int mid = (low+high)/2;
            if(nums[mid] >= target){
                ans = mid;
                high = mid-1;
            }
            else {
                low = mid+1;
            }
           
        }
         nums[ans] = target;
    }
public:
    int lengthOfLIS(vector<int>& nums) {
        vector<int> store;
        for(int i : nums){
            int n = store.size();
            if(n == 0) store.push_back(i);
            else if( store[n-1] < i) store.push_back(i);
            else if(store[n-1] > i){
                binary(store,i);
            }
        }
        return store.size();
    }
};
