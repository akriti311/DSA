class Solution {
public:
 int solve(vector<int>& nums, int startIndex, int lastIndex) {
         int n = lastIndex - startIndex +1;
  
       
     
        if(n ==1) return nums[startIndex];
        
        
       int prev = nums[startIndex];
       int prev2 = 0;    // jab index negative hoga 

        for(int i =startIndex +1; i<=lastIndex; i++){
        int pick = nums[i] + prev2;
        
        int not_pick = prev;
       
         int curri =  max(pick, not_pick);
         prev2 = prev;
         prev = curri;
        }

         return prev;
    }
    int rob(vector<int>& nums) {
       int n = nums.size();
        if(n == 1) return nums[0];
        int case1 = solve(nums, 0, n-2);
        int case2 = solve(nums, 1, n-1);

        return max(case1, case2);
    }
};
